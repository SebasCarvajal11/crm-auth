# Copiar a .env y ajustar

DATABASE_URL=postgres://auth_user:authpassword@localhost:15432/crm_database
DB_SCHEMA=schema_auth
NODE_ENV=development
PORT=3000
# Ruta del cookie de refresh (debe coincidir con la URL del SPA: /api/v1/auth/refresh)
REFRESH_COOKIE_PATH=/api/v1/auth/refresh

# Limites de solicitud de recuperacion por cuenta (defensa anti abuso)
PASSWORD_RESET_MIN_INTERVAL_MS=900000
PASSWORD_RESET_MAX_PER_DAY=3

# Rate limiting
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_VERIFY_EMAIL_MAX=10
RATE_LIMIT_VERIFY_EMAIL_WINDOW_MS=3600000
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=3600000

# Opcional: Redis para cola BullMQ y reintentos distribuidos de correo
REDIS_URL=redis://127.0.0.1:6379
AUTH_EVENTS_STREAM_KEY=stream:auth.identity
AUTH_EVENTS_STREAM_MAXLEN=10000

# JWT - regenerar con pnpm jwt:gen-keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=mod-auth-rsa-1

# --- URLs publicas usadas en correos ---
APP_PUBLIC_URL=http://localhost:5173

# --- Correo transaccional ---
# `MAIL_FROM` debe corresponder a un remitente verificado en Brevo.
MAIL_FROM="CIMA CRM <noreply@example.com>"
MAIL_TRANSPORT=smtp
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_OUTBOX_ENCRYPTION_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Brevo puede presentar certificado sobre el hostname heredado de Sendinblue.
SMTP_TLS_SERVERNAME=smtp-relay.sendinblue.com
SMTP_USER=
SMTP_PASS=
