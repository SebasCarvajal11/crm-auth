# Copiar a .env y ajustar

DATABASE_URL=postgres://root:rootpassword@localhost:5432/crm_database
NODE_ENV=development
PORT=3000

# CORS en mod-auth: por defecto OFF (el SPA usa KrakenD :8080, que ya envía CORS).
# Pon MOD_AUTH_CORS=true solo si el navegador llama directamente a http://localhost:3000.
# MOD_AUTH_CORS=true
# CORS_ORIGIN=http://localhost:5173

# Opcional: Redis para rate limit distribuido de login
# REDIS_URL=redis://127.0.0.1:6379

# JWT — regenerar con npm run jwt:gen-keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=mod-auth-rsa-1

# --- Confianza en KrakenD (evita verificar JWT dos veces en mod-auth) ---
# Por defecto desactivado: mod-auth sigue validando Bearer con RS256.
# Si omites estas variables, el servidor asume TRUST_GATEWAY_JWT_HEADERS=false.
# Si activas, KrakenD debe inyectar X-Gateway-Trust (Martian); mismo valor aquí y en krakend.json.
# Generar krakend parcheado: desde la raíz del repo → node scripts/patch-krakend-gateway-trust.mjs
TRUST_GATEWAY_JWT_HEADERS=false
# TRUST_GATEWAY_JWT_HEADERS=true
# GATEWAY_TRUST_SECRET=cima-local-gateway-trust-secret-do-not-use-production-2026
