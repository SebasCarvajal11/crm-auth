        "client_max_rate": 3,
        "client_capacity": 3,
        "every": "1h",
        "strategy": "ip"
      },
      "public": true
    },
    {
      "endpoint": "/api/v1/auth/reset-password",
      "method": "POST",
      "backend_url": "/api/v1/auth/reset-password",
