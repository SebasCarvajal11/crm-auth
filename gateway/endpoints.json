      "public": true
    },
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "backend_url": "/api/v1/auth/login",
      "rate_limit": {
        "client_max_rate": 200,
        "client_capacity": 200,
        "every": "15m",
        "strategy": "ip"
      },
      "public": true
    },
    {
      "endpoint": "/api/v1/auth/refresh",
      "method": "POST",
      "backend_url": "/api/v1/auth/refresh",
      "extra_headers": ["Cookie"],
      "public": true
    },
    {
