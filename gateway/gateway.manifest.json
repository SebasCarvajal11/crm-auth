{
  "service": "auth",
  "version": "1.0.0",
  "endpoints": [
    {
      "endpoint": "/api/v1/health",
      "method": "GET",
      "backend_url": "/api/v1/health",
      "public": true,
      "openapi_ref": "GET /api/v1/health"
    },
    {
      "endpoint": "/api/v1/.well-known/jwks.json",
      "method": "GET",
      "backend_url": "/api/v1/.well-known/jwks.json",
      "public": true,
      "openapi_ref": "GET /api/v1/.well-known/jwks.json"
    },
    {
      "endpoint": "/api/v1/docs/auth/openapi.yaml",
      "method": "GET",
      "backend_url": "/api/v1/openapi.yaml",
      "public": true,
      "openapi_ref": "GET /api/v1/openapi.yaml"
    },
    {
      "endpoint": "/api/v1/docs/auth/v1/openapi.yaml",
      "method": "GET",
      "backend_url": "/api/v1/openapi.yaml",
      "public": true,
      "openapi_ref": "GET /api/v1/openapi.yaml"
    },
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "backend_url": "/api/v1/auth/login",
      "rate_limit": {
        "client_max_rate": 200,
        "client_capacity": 200,
        "every": "15m",
        "strategy": "ip"
      },
      "public": true,
      "openapi_ref": "POST /api/v1/auth/login"
    },
    {
      "endpoint": "/api/v1/auth/refresh",
      "method": "POST",
      "backend_url": "/api/v1/auth/refresh",
      "extra_headers": ["Cookie"],
      "public": true,
      "openapi_ref": "POST /api/v1/auth/refresh"
    },
    {
      "endpoint": "/api/v1/auth/forgot-password",
      "method": "POST",
      "backend_url": "/api/v1/auth/forgot-password",
      "rate_limit": {
        "client_max_rate": 3,
        "client_capacity": 3,
        "every": "1h",
        "strategy": "ip"
      },
      "public": true,
      "openapi_ref": "POST /api/v1/auth/forgot-password"
    },
    {
      "endpoint": "/api/v1/auth/reset-password",
      "method": "POST",
      "backend_url": "/api/v1/auth/reset-password",
      "rate_limit": {
        "client_max_rate": 5,
        "client_capacity": 5,
        "every": "1h",
        "strategy": "ip"
      },
      "public": true,
      "openapi_ref": "POST /api/v1/auth/reset-password"
    },
    {
      "endpoint": "/api/v1/auth/accept-invite/{token}",
      "method": "GET",
      "backend_url": "/api/v1/auth/accept-invite/{token}",
      "public": true,
      "openapi_ref": "GET /api/v1/auth/accept-invite/{token}"
    },
    {
      "endpoint": "/api/v1/auth/accept-invite",
      "method": "POST",
      "backend_url": "/api/v1/auth/accept-invite",
      "rate_limit": {
        "client_max_rate": 5,
        "client_capacity": 5,
        "every": "1h",
        "strategy": "ip"
      },
      "public": true,
      "openapi_ref": "POST /api/v1/auth/accept-invite"
    },
    {
      "endpoint": "/api/v1/auth/verify-email",
      "method": "POST",
      "backend_url": "/api/v1/auth/verify-email",
      "rate_limit": {
        "client_max_rate": 10,
        "client_capacity": 10,
        "every": "1h",
        "strategy": "ip"
      },
      "public": true,
      "openapi_ref": "POST /api/v1/auth/verify-email"
    },
    {
      "endpoint": "/api/v1/identity/me",
      "method": "GET",
      "backend_url": "/api/v1/auth/me",
      "openapi_ref": "GET /api/v1/auth/me"
    },
    {
      "endpoint": "/api/v1/identity/logout",
      "method": "POST",
      "backend_url": "/api/v1/auth/logout",
      "extra_headers": [
        "Cookie"
      ],
      "openapi_ref": "POST /api/v1/auth/logout"
    },
    {
      "endpoint": "/api/v1/identity/search",
      "method": "GET",
      "backend_url": "/api/v1/auth/users/search",
      "input_query_strings": [
        "q",
        "role"
      ],
      "openapi_ref": "GET /api/v1/auth/users/search"
    },
    {
      "endpoint": "/api/v1/account/password",
      "method": "POST",
      "backend_url": "/api/v1/auth/change-password",
      "openapi_ref": "POST /api/v1/auth/change-password"
    },
    {
      "endpoint": "/api/v1/account/sessions",
      "method": "GET",
      "backend_url": "/api/v1/auth/sessions",
      "openapi_ref": "GET /api/v1/auth/sessions"
    },
    {
      "endpoint": "/api/v1/account/sessions/{familyId}",
      "method": "DELETE",
      "backend_url": "/api/v1/auth/sessions/{familyId}",
      "openapi_ref": "DELETE /api/v1/auth/sessions/{familyId}"
    },
    {
      "endpoint": "/api/v1/account/verify-email/request",
      "method": "POST",
      "backend_url": "/api/v1/auth/request-email-verification",
      "openapi_ref": "POST /api/v1/auth/request-email-verification"
    },
    {
      "endpoint": "/api/v1/admin/workers",
      "method": "POST",
      "backend_url": "/api/v1/auth/register-worker",
      "openapi_ref": "POST /api/v1/auth/register-worker"
    },
    {
      "endpoint": "/api/v1/admin/admins/invite",
      "method": "POST",
      "backend_url": "/api/v1/auth/invite-admin",
      "openapi_ref": "POST /api/v1/auth/invite-admin"
    },
    {
      "endpoint": "/api/v1/admin/clients/invite",
      "method": "POST",
      "backend_url": "/api/v1/auth/invite-client",
      "openapi_ref": "POST /api/v1/auth/invite-client"
    },
    {
      "endpoint": "/api/v1/admin/users",
      "method": "GET",
      "backend_url": "/api/v1/auth/users",
      "input_query_strings": [
        "page",
        "limit",
        "role",
        "include_deleted",
        "q"
      ],
      "openapi_ref": "GET /api/v1/auth/users"
    },
    {
      "endpoint": "/api/v1/admin/users/{subject}/status",
      "method": "PATCH",
      "backend_url": "/api/v1/auth/users/{subject}/status",
      "openapi_ref": "PATCH /api/v1/auth/users/{subject}/status"
    },
    {
      "endpoint": "/api/v1/admin/users/{subject}/flags",
      "method": "PATCH",
      "backend_url": "/api/v1/auth/users/{subject}/flags",
      "openapi_ref": "PATCH /api/v1/auth/users/{subject}/flags"
    },
    {
      "endpoint": "/api/v1/admin/users/{subject}/restore",
      "method": "POST",
      "backend_url": "/api/v1/auth/users/{subject}/restore",
      "openapi_ref": "POST /api/v1/auth/users/{subject}/restore"
    },
    {
      "endpoint": "/api/v1/admin/users/{subject}",
      "method": "DELETE",
      "backend_url": "/api/v1/auth/users/{subject}",
      "openapi_ref": "DELETE /api/v1/auth/users/{subject}"
    }
  ]
}
