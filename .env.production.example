DATABASE_URL=postgres://auth_user:<auth-db-password>@postgres_db:5432/crm_database
DB_SCHEMA=schema_auth
NODE_ENV=production
EXPOSE_TEMP_PASSWORDS=false
PORT=3000
REFRESH_COOKIE_PATH=/api/auth/refresh
PASSWORD_RESET_MIN_INTERVAL_MS=900000
PASSWORD_RESET_MAX_PER_DAY=3
REDIS_URL=redis://redis:6379
AUTH_EVENTS_STREAM_KEY=auth:events
AUTH_EVENTS_STREAM_MAXLEN=10000
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=mod-auth-rsa-1
TRUST_GATEWAY_JWT_HEADERS=true
GATEWAY_TRUST_SECRET=
APP_PUBLIC_URL=https://crm.example.com
ADMIN_INVITE_SECRET=
MAIL_FROM="CIMA CRM <noreply@example.com>"
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_SERVERNAME=
SMTP_USER=
SMTP_PASS=
