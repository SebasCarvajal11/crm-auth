{
  "name": "crm-auth",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:email": "tsx src/workers/email.worker.ts",
    "worker:cleanup": "tsx src/workers/token-cleanup.worker.ts",
    "cleanup:tokens": "tsx src/scripts/run-token-cleanup.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "preinstall": "pnpm dlx only-allow pnpm",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:partition-audit-migrate": "tsx src/db/scripts/migrate-audit-logs-partitioned.ts",
    "db:ensure-audit-partitions": "tsx src/db/scripts/run-ensure-audit-partitions.ts",
    "jwt:gen-keys": "tsx src/scripts/gen-jwt-keys.ts",
    "test": "tsx src/scripts/run-hurl-suite.ts",
    "test:rate-limit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-rate-limit.ps1"
  },
  "description": "Identity and access service for the CIMA CRM multi-repo platform.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebasCarvajal11/crm-auth.git"
  },
  "bugs": {
    "url": "https://github.com/SebasCarvajal11/crm-auth/issues"
  },
  "homepage": "https://github.com/SebasCarvajal11/crm-auth#readme",
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.8.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "ioredis": "^5.10.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3"
  }
}
