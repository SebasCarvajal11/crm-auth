{
  "name": "crm-auth",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "predev": "pnpm --prefix cima-contracts build",
    "dev": "tsx watch src/server.ts",
    "worker:email": "tsx src/workers/email.worker.ts",
    "worker:email-outbox": "tsx src/workers/email-outbox.worker.ts",
    "worker:identity-outbox": "tsx src/workers/identity-outbox.worker.ts",
    "worker:cleanup": "tsx src/workers/token-cleanup.worker.ts",
    "pii:clean": "tsx src/scripts/pii-clean.ts",
    "build": "pnpm --prefix cima-contracts build && tsc",
    "start": "tsx src/server.ts",
    "preinstall": "pnpm dlx only-allow pnpm",
    "db:bootstrap": "tsx src/db/scripts/bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:partition-audit-migrate": "tsx src/db/scripts/migrate-audit-logs-partitioned.ts",
    "db:ensure-audit-partitions": "tsx src/db/scripts/run-ensure-audit-partitions.ts",
    "jwt:gen-keys": "tsx src/scripts/gen-jwt-keys.ts",
    "openapi:check": "node scripts/validate-openapi.mjs",
    "gateway:validate": "tsx scripts/validate-manifest.mjs",
    "test:contract": "hurl --test --variable base_url=http://localhost:28080 tests/09_auth_gateway.hurl",
    "test": "tsx src/scripts/run-hurl-suite.ts",
    "test:rate-limit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-rate-limit.ps1",
    "test:unit": "vitest run"
  },
  "description": "Identity and access service for the CIMA CRM multi-repo platform.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebasCarvajal11/crm-auth.git"
  },
  "bugs": {
    "url": "https://github.com/SebasCarvajal11/crm-auth/issues"
  },
  "homepage": "https://github.com/SebasCarvajal11/crm-auth#readme",
  "dependencies": {
    "@sebascarvajal11/cima-contracts": "workspace:*",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.8.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-kit": "^0.31.10",
    "hono": "^4.12.18",
    "ioredis": "^5.11.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "tsx": "^4.21.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8",
    "yaml": "^2.7.0"
  }
}
